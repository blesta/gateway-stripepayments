<?php
// The settings content renders inside the manage page's own <form>, where a nested form
// would be dropped by the HTML parser. The OAuth forms and their confirmation modals are
// therefore declared inside an inert <template> and moved to <body> by the script below;
// the buttons above reference them through the HTML5 "form" attribute
if (!empty($gateway_id)) {
?>
<template id="stripe_oauth_templates">
    <?php
    if ($state == 'unconfigured') {
        $this->Form->create($oauth_action_url, ['id' => 'stripe_oauth_connect_live_form']);
        $this->Form->fieldHidden('gateway_id', $gateway_id);
        $this->Form->fieldHidden('op', 'connect');
        $this->Form->fieldHidden('mode', 'live');
        $this->Form->end();

        $this->Form->create($oauth_action_url, ['id' => 'stripe_oauth_connect_test_form']);
        $this->Form->fieldHidden('gateway_id', $gateway_id);
        $this->Form->fieldHidden('op', 'connect');
        $this->Form->fieldHidden('mode', 'test');
        $this->Form->end();
    }

    if ($state == 'api_keys' && !empty($convert_mode)) {
        $this->Form->create($oauth_action_url, ['id' => 'stripe_oauth_convert_form']);
        $this->Form->fieldHidden('gateway_id', $gateway_id);
        $this->Form->fieldHidden('op', 'connect');
        $this->Form->fieldHidden('mode', $convert_mode);
        $this->Form->fieldHidden('intent', 'convert');
        $this->Form->end();

        if ($convert_mode == 'test') {
    ?>
    <div class="modal fade" id="stripe_oauth_convert_modal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><?php $this->_('StripePayments.oauth.modal_convert_test_title'); ?></h5>
                </div>
                <div class="modal-body"><?php $this->_('StripePayments.oauth.modal_convert_test_text'); ?></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-stripe-modal-dismiss>
                        <?php $this->_('StripePayments.oauth.modal_cancel'); ?>
                    </button>
                    <button type="submit" form="stripe_oauth_convert_form" class="btn btn-primary">
                        <?php $this->_('StripePayments.oauth.convert'); ?>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <?php
        }
    }

    if ($state == 'connected') {
        $this->Form->create($oauth_action_url, ['id' => 'stripe_oauth_disconnect_form']);
        $this->Form->fieldHidden('gateway_id', $gateway_id);
        $this->Form->fieldHidden('op', 'disconnect');
        $this->Form->end();
    ?>
    <div class="modal fade" id="stripe_oauth_disconnect_modal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><?php $this->_('StripePayments.oauth.modal_disconnect_title'); ?></h5>
                </div>
                <div class="modal-body"><?php $this->_('StripePayments.oauth.modal_disconnect_text'); ?></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-stripe-modal-dismiss>
                        <?php $this->_('StripePayments.oauth.modal_cancel'); ?>
                    </button>
                    <button type="submit" form="stripe_oauth_disconnect_form" class="btn btn-danger">
                        <?php $this->_('StripePayments.oauth.disconnect'); ?>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <?php
        if ($mode != 'live') {
            $this->Form->create($oauth_action_url, ['id' => 'stripe_oauth_switch_form']);
            $this->Form->fieldHidden('gateway_id', $gateway_id);
            $this->Form->fieldHidden('op', 'switch');
            $this->Form->fieldHidden('mode', 'live');
            $this->Form->end();
    ?>
    <div class="modal fade" id="stripe_oauth_switch_modal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><?php $this->_('StripePayments.oauth.modal_switch_title'); ?></h5>
                </div>
                <div class="modal-body"><?php $this->_('StripePayments.oauth.modal_switch_text'); ?></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-stripe-modal-dismiss>
                        <?php $this->_('StripePayments.oauth.modal_cancel'); ?>
                    </button>
                    <button type="submit" form="stripe_oauth_switch_form" class="btn btn-primary">
                        <?php $this->_('StripePayments.oauth.switch_to_live'); ?>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <?php
        }
    }
    ?>
</template>
<script type="text/javascript">
    (function () {
        var template = document.getElementById('stripe_oauth_templates');
        if (!template) {
            return;
        }
        document.body.appendChild(template.content);
        template.remove();

        function closeModal(modal) {
            modal.classList.remove('show');
            modal.style.display = 'none';
            document.body.classList.remove('modal-open');
            document.querySelectorAll('[data-stripe-oauth-backdrop]').forEach(function (el) {
                el.remove();
            });
        }

        document.addEventListener('click', function (event) {
            var opener = event.target.closest('[data-stripe-modal]');
            if (opener) {
                event.preventDefault();
                var modal = document.querySelector(opener.getAttribute('data-stripe-modal'));
                if (modal) {
                    modal.classList.add('show');
                    modal.style.display = 'block';
                    document.body.classList.add('modal-open');
                    var backdrop = document.createElement('div');
                    backdrop.className = 'modal-backdrop fade show';
                    backdrop.setAttribute('data-stripe-oauth-backdrop', '');
                    document.body.appendChild(backdrop);
                }
                return;
            }
            if (event.target.closest('[data-stripe-modal-dismiss]')) {
                var open_modal = event.target.closest('.modal');
                if (open_modal) {
                    closeModal(open_modal);
                }
            }
        });
    })();
</script>
<?php
}
?>
