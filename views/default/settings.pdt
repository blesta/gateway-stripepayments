<?php
// The settings content renders inside the manage page's own <form>, where a nested form
// would be dropped by the HTML parser. The OAuth forms and their confirmation modals are
// therefore declared inside an inert <template> and moved to <body> by the script below;
// the buttons above reference them through the HTML5 "form" attribute
if (!empty($gateway_id)) {
?>
<template id="stripe_oauth_templates">
    <?php
    if ($state == 'unconfigured') {
        $this->Form->create($oauth_action_url, ['id' => 'stripe_oauth_connect_live_form']);
        $this->Form->fieldHidden('gateway_id', $gateway_id);
        $this->Form->fieldHidden('op', 'connect');
        $this->Form->fieldHidden('mode', 'live');
        $this->Form->end();

        $this->Form->create($oauth_action_url, ['id' => 'stripe_oauth_connect_test_form']);
        $this->Form->fieldHidden('gateway_id', $gateway_id);
        $this->Form->fieldHidden('op', 'connect');
        $this->Form->fieldHidden('mode', 'test');
        $this->Form->end();
    }

    if ($state == 'api_keys' && !empty($convert_mode)) {
        $this->Form->create($oauth_action_url, ['id' => 'stripe_oauth_convert_form']);
        $this->Form->fieldHidden('gateway_id', $gateway_id);
        $this->Form->fieldHidden('op', 'connect');
        $this->Form->fieldHidden('mode', $convert_mode);
        $this->Form->fieldHidden('extras[intent]', 'convert');
        $this->Form->end();
    }

    // Connecting another account, from API keys or from an existing connection, shares one
    // confirmation dialog. Each submit button joins its form through the "form" attribute
    $account_modal = null;
    if ($state == 'api_keys') {
        $this->Form->create($oauth_action_url, ['id' => 'stripe_oauth_replace_form']);
        $this->Form->fieldHidden('gateway_id', $gateway_id);
        $this->Form->fieldHidden('op', 'connect');
        $this->Form->fieldHidden('mode', $replace_mode);
        $this->Form->fieldHidden('extras[intent]', 'replace');
        $this->Form->end();

        $account_modal = [
            'id' => 'stripe_oauth_replace_modal',
            'form' => 'stripe_oauth_replace_form',
            'test_form' => null,
            'lang' => 'replace',
            'submit_class' => 'btn-danger'
        ];
    } elseif ($state == 'connected') {
        // Reconnecting goes live by default; test mode is the small opt-in, as on first connect
        foreach (['live', 'test'] as $reconnect_mode) {
            $this->Form->create($oauth_action_url, ['id' => 'stripe_oauth_reconnect_' . $reconnect_mode . '_form']);
            $this->Form->fieldHidden('gateway_id', $gateway_id);
            $this->Form->fieldHidden('op', 'connect');
            $this->Form->fieldHidden('mode', $reconnect_mode);
            $this->Form->end();
        }

        $account_modal = [
            'id' => 'stripe_oauth_reconnect_modal',
            'form' => 'stripe_oauth_reconnect_live_form',
            'test_form' => 'stripe_oauth_reconnect_test_form',
            'lang' => 'reconnect',
            // The current connection stays until the new one succeeds, so nothing is at risk
            'submit_class' => 'btn-primary'
        ];
    }

    if ($account_modal) {
    ?>
    <div class="modal fade" id="<?php echo $account_modal['id']; ?>" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><?php $this->_('StripePayments.oauth.modal_' . $account_modal['lang'] . '_title'); ?></h5>
                </div>
                <div class="modal-body">
                    <p class="<?php echo (!empty($stored_account_count) ? 'mb-3' : 'mb-0'); ?>">
                        <?php $this->_('StripePayments.oauth.modal_' . $account_modal['lang'] . '_text'); ?>
                    </p>
                    <?php
                    if (!empty($stored_account_count)) {
                    ?>
                    <div class="alert alert-warning py-2 mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <?php
                        $this->_(
                            'StripePayments.oauth.modal_' . $account_modal['lang'] . '_count'
                                . ($stored_account_count == 1 ? '_one' : ''),
                            false,
                            (int) $stored_account_count
                        );
                        ?>
                    </div>
                    <?php
                    }
                    ?>
                </div>
                <div class="modal-footer">
                    <?php
                    if ($account_modal['test_form']) {
                    ?>
                    <button type="submit" form="<?php echo $account_modal['test_form']; ?>" class="btn btn-link btn-sm me-auto">
                        <?php $this->_('StripePayments.oauth.modal_reconnect_test'); ?>
                    </button>
                    <?php
                    }
                    ?>
                    <button type="button" class="btn btn-secondary" data-stripe-modal-dismiss>
                        <?php $this->_('StripePayments.oauth.modal_cancel'); ?>
                    </button>
                    <button type="submit" form="<?php echo $account_modal['form']; ?>" class="btn <?php echo $account_modal['submit_class']; ?>">
                        <?php $this->_('StripePayments.oauth.modal_' . $account_modal['lang'] . '_submit'); ?>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <?php
    }

    if ($pending) {
        $this->Form->create($oauth_action_url, ['id' => 'stripe_oauth_cancel_form']);
        $this->Form->fieldHidden('gateway_id', $gateway_id);
        $this->Form->fieldHidden('op', 'cancel');
        $this->Form->end();
    }

    if (!empty($pending_revocations)) {
        $this->Form->create($oauth_action_url, ['id' => 'stripe_oauth_retry_form']);
        $this->Form->fieldHidden('gateway_id', $gateway_id);
        $this->Form->fieldHidden('op', 'retry_revocations');
        $this->Form->end();
    }

    if ($state == 'connected') {
        $this->Form->create($oauth_action_url, ['id' => 'stripe_oauth_disconnect_form']);
        $this->Form->fieldHidden('gateway_id', $gateway_id);
        $this->Form->fieldHidden('op', 'disconnect');
        $this->Form->end();
    ?>
    <div class="modal fade" id="stripe_oauth_disconnect_modal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><?php $this->_('StripePayments.oauth.modal_disconnect_title'); ?></h5>
                </div>
                <div class="modal-body"><?php $this->_('StripePayments.oauth.modal_disconnect_text'); ?></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-stripe-modal-dismiss>
                        <?php $this->_('StripePayments.oauth.modal_cancel'); ?>
                    </button>
                    <button type="submit" form="stripe_oauth_disconnect_form" class="btn btn-danger">
                        <?php $this->_('StripePayments.oauth.disconnect'); ?>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <?php
    }
    ?>
</template>
<script type="text/javascript">
    (function () {
        var template = document.getElementById('stripe_oauth_templates');
        if (!template) {
            return;
        }
        document.body.appendChild(template.content);
        template.remove();

        function closeModal(modal) {
            modal.classList.remove('show');
            modal.style.display = 'none';
            document.body.classList.remove('modal-open');
            document.querySelectorAll('[data-stripe-oauth-backdrop]').forEach(function (el) {
                el.remove();
            });
        }

        document.addEventListener('click', function (event) {
            var opener = event.target.closest('[data-stripe-modal]');
            if (opener) {
                event.preventDefault();
                var modal = document.querySelector(opener.getAttribute('data-stripe-modal'));
                if (modal) {
                    modal.classList.add('show');
                    modal.style.display = 'block';
                    document.body.classList.add('modal-open');
                    var backdrop = document.createElement('div');
                    backdrop.className = 'modal-backdrop fade show';
                    backdrop.setAttribute('data-stripe-oauth-backdrop', '');
                    document.body.appendChild(backdrop);
                }
                return;
            }
            if (event.target.closest('[data-stripe-modal-dismiss]')) {
                var open_modal = event.target.closest('.modal');
                if (open_modal) {
                    closeModal(open_modal);
                }
            }
        });
    })();
</script>
<?php
}
?>
