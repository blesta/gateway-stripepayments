<div id="stripe-ach-verification">
    <p><?php $this->_('StripePayments.ach_verification_form.notice'); ?></p>

    <div class="form-group">
        <?php
        $this->Form->label(
            $this->_('StripePayments.ach_verification_form.field_descriptor_code', true),
            'descriptor_code'
        );
        $this->Form->fieldText(
            'descriptor_code',
            ($vars->descriptor_code ?? ''),
            [
                'id' => 'descriptor_code',
                'class' => 'form-control',
                'maxlength' => '6',
                'placeholder' => $this->_('StripePayments.ach_verification_form.placeholder_descriptor_code', true)
            ]
        );
        ?>
        <span class="form-text text-muted">
            <small><?php $this->_('StripePayments.ach_verification_form.tooltip_descriptor_code'); ?></small>
        </span>
    </div>

    <p class="mt-3 mb-1"><small><?php $this->_('StripePayments.ach_verification_form.amounts_notice'); ?></small></p>

    <div class="form-group">
        <?php
        $this->Form->label(
            $this->_('StripePayments.ach_verification_form.field_first_deposit', true),
            'first_deposit'
        );
        $this->Form->fieldText(
            'first_deposit',
            ($vars->first_deposit ?? ''),
            [
                'id' => 'first_deposit',
                'class' => 'form-control',
                'maxlength' => '2',
                'placeholder' => '0.'
            ]
        );
        ?>
    </div>

    <div class="form-group">
        <?php
        $this->Form->label(
            $this->_('StripePayments.ach_verification_form.field_second_deposit', true),
            'second_deposit'
        );
        $this->Form->fieldText(
            'second_deposit',
            ($vars->second_deposit ?? ''),
            [
                'id' => 'second_deposit',
                'class' => 'form-control',
                'maxlength' => '2',
                'placeholder' => '0.'
            ]
        );
        ?>
    </div>
</div>
