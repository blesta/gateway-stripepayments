<div id="stripe-payment-confirmation">
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        // Vanilla JS so the confirmation works in every theme (the Paradigm admin theme has no jQuery)
        (function () {
            function init() {
                var wrapper = document.getElementById('stripe-payment-confirmation');
                if (!wrapper) {
                    return;
                }

                var form = wrapper.closest('form');
                if (!form) {
                    return;
                }

                // Create a Stripe client
                var stripe = Stripe('<?php echo (isset($meta['publishable_key']) ? $this->Html->safe($meta['publishable_key']) : null);?>');

                // Identify this gateway to Stripe on client-side requests
                <?php if (!empty($app_info)) { ?>
                stripe.registerAppInfo(<?php echo json_encode($app_info);?>);
                <?php } ?>

                var confirmed = false;

                function enableFormSubmission() {
                    confirmed = false;
                    form.dataset.submitted = 'false';
                    form.dataset.submitting = 'false';
                    form.querySelectorAll('input[type="submit"], button[type="submit"]').forEach(function (btn) {
                        btn.disabled = false;
                        btn.classList.remove('disabled');
                    });

                    // The theme's double submit guard tracks state in jQuery's data store,
                    // which the dataset attributes above do not reach
                    if (window.jQuery) {
                        window.jQuery(form).data('submitted', false);
                    }
                }

                // Bind natively for themes without jQuery, and through jQuery for callers that submit
                // with jQuery's trigger, which calls form.submit() and so dispatches no submit event
                function bindSubmit() {
                    form.addEventListener('submit', submitPayment);
                    if (window.jQuery) {
                        window.jQuery(form).on('submit', submitPayment);
                    }
                }

                function unbindSubmit() {
                    form.removeEventListener('submit', submitPayment);
                    if (window.jQuery) {
                        window.jQuery(form).off('submit', submitPayment);
                    }
                }

                // Handle form submission (only once)
                bindSubmit();

                function submitPayment(event) {
                    // A real submit reaches both the native and the jQuery handler, only confirm once
                    if (confirmed) {
                        return;
                    }

                    // Skip attempting a payment if the submission is to edit in Blesta, not submit the payment
                    var submitBtn = document.activeElement;

                    if (submitBtn
                        && form.contains(submitBtn)
                        && submitBtn.matches('button[type="submit"], input[type="submit"]')
                        && submitBtn.getAttribute('name') === 'submit_edit'
                    ) {
                        return;
                    }

                    confirmed = true;
                    event.preventDefault();
                    // Confirm the PaymentIntent, the card will not actually be charged until we capture server side
                    stripe.handleCardPayment(
                        '<?php echo (isset($payment_intent->client_secret) ? $this->Html->safe($payment_intent->client_secret) : null);?>',
                        {payment_method: '<?php echo (isset($payment_intent->payment_method) ? $this->Html->safe($payment_intent->payment_method) : null);?>'}
                    ).then(function (result) {
                        // Resubmit the form, bypassing this handler
                        unbindSubmit();
                        enableFormSubmission();
                        form.submit();
                    }, function () {
                        // Stripe.js failed outright (e.g. network error), so no confirmation was
                        // attempted; re-enable the form so the payment can be retried
                        enableFormSubmission();
                    });
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>
</div>
