<div id="stripe-ach-form">
    <div id="ach-element">
<?php
        if ($legacy ?? false) {
        ?>
        <div class="alert alert-warning" id="ach-legacy-notice">
            <?php $this->_('StripePayments.ach_form.legacy_notice'); ?>
        </div>
        <?php
        } elseif ($editing ?? false) {
        ?>
        <div id="ach-current">
            <p class="mb-0"><strong><?php
                $this->_(
                    'StripePayments.ach_form.current_account',
                    false,
                    ($types[$account_info['type'] ?? ''] ?? ''),
                    ($account_info['last4'] ?? '')
                );
            ?></strong></p>
            <button type="button" class="btn btn-outline-secondary mt-3" id="ach-replace-button">
                <?php $this->_('StripePayments.ach_form.replace_button'); ?>
            </button>
        </div>
        <?php
        }
        ?>
        <div id="ach-collect"<?php echo (($editing ?? false) && !($legacy ?? false)) ? ' style="display: none;"' : ''; ?>>
            <p><?php $this->_('StripePayments.ach_form.collect_notice'); ?></p>
            <button type="button" class="btn btn-outline-secondary mt-3" id="ach-collect-button" disabled>
                <?php $this->_('StripePayments.ach_form.collect_button'); ?>
            </button>
            <p class="mt-2 mb-0" id="ach-collect-requirements">
                <small><?php $this->_('StripePayments.ach_form.collect_requirements'); ?></small>
            </p>
        </div>

        <div id="ach-mandate" style="display: none;">
            <p class="mb-1"><strong id="ach-account-summary"></strong></p>
            <p class="mb-0 mt-2"><small><?php $this->_('StripePayments.ach_form.mandate_authorization', false, ($company->name ?? ''));?></small></p>
            <p class="mt-0 mb-2"><small><?php $this->_('StripePayments.ach_form.mandate_future_usage', false, ($company->name ?? ''));?></small></p>
            <button type="button" class="btn btn-outline-secondary mt-3" id="ach-accept-button">
                <?php $this->_('StripePayments.ach_form.mandate_accept'); ?>
            </button>
            <span id="ach-working" style="display: none;"><?php $this->_('StripePayments.ach_form.working'); ?></span>
        </div>

        <div id="ach-complete" style="display: none;">
            <p class="mb-0"><strong id="ach-complete-message"></strong></p>
        </div>
    </div>

    <!-- Used to display form errors. -->
    <div id="ach-errors" role="alert"></div>
    <?php
    $this->Form->fieldHidden('type', ($account_info['type'] ?? ''), ['id' => 'type']);
    $this->Form->fieldHidden('reference_id', '', ['id' => 'reference_id']);
    ?>

    <?php if ($load_stripe ?? false) { ?><script src="https://js.stripe.com/v3/"></script><?php } ?>
    <script>
        // Vanilla JS so the form works in every theme (the Paradigm admin theme has no jQuery)
        (function () {
            function init() {
                var wrapper = document.getElementById('stripe-ach-form');
                if (!wrapper) {
                    return;
                }

                var form = wrapper.closest('form');
                if (!form) {
                    return;
                }

                var submitting = false;

                // Load the gateway stylesheet
                if (!document.querySelector('link[data-stripe-payments]')) {
                    var link = document.createElement('link');
                    link.setAttribute('data-stripe-payments', '');
                    link.rel = 'stylesheet';
                    link.media = 'screen';
                    link.type = 'text/css';
                    link.href = '<?php echo $this->Html->safe($this->view_dir . 'css/styles.css');?>';
                    document.head.appendChild(link);
                }

                // Create a Stripe client
                var stripe_ach = Stripe('<?php echo (isset($meta['publishable_key']) ? $this->Html->safe($meta['publishable_key']) : null);?>');
                var setup_secret = '<?php echo (isset($setup_intent->client_secret) ? $this->Html->safe($setup_intent->client_secret) : null);?>';
                var billing_email = '<?php echo $this->Html->safe($billing_email ?? '');?>';

                // Identify this gateway to Stripe on client-side requests
                <?php if (!empty($app_info)) { ?>
                stripe_ach.registerAppInfo(<?php echo json_encode($app_info);?>);
                <?php } ?>

                var collect_step = wrapper.querySelector('#ach-collect');
                var mandate_step = wrapper.querySelector('#ach-mandate');
                var complete_step = wrapper.querySelector('#ach-complete');
                var errors_el = wrapper.querySelector('#ach-errors');
                var working_el = wrapper.querySelector('#ach-working');
                var collect_button = wrapper.querySelector('#ach-collect-button');
                var accept_button = wrapper.querySelector('#ach-accept-button');
                var requirements_el = wrapper.querySelector('#ach-collect-requirements');
                var current_step = wrapper.querySelector('#ach-current');
                var replace_button = wrapper.querySelector('#ach-replace-button');

                // Stripe needs the account holder's name, and the billing address is what the
                // mandate is recorded against, so the account cannot be collected until the
                // contact fields on the surrounding Blesta form are filled in
                var required_contact_fields = ['first_name', 'last_name', 'address1', 'city', 'state', 'zip'];

                // The form cannot be saved until the mandate has been accepted and Stripe has
                // returned the PaymentMethod, since that is what gets stored as the payment account
                var setup_complete = false;

                // On an edit the account already on file stands until the customer chooses to
                // replace it, so nothing needs collecting and the form saves as normal
                var editing = <?php echo (($editing ?? false) && !($legacy ?? false)) ? 'true' : 'false'; ?>;
                var replacing = false;

                function fieldValue(id) {
                    var el = document.getElementById(id);

                    return el ? el.value : '';
                }

                function wrapperField(id) {
                    var el = wrapper.querySelector('#' + id);

                    return el ? el.value : '';
                }

                function setWrapperField(id, value) {
                    var el = wrapper.querySelector('#' + id);
                    if (el) {
                        el.value = value;
                    }
                }

                function isVisible(el) {
                    return !!(el && el.offsetParent !== null);
                }

                function contactFieldsComplete() {
                    for (var i = 0; i < required_contact_fields.length; i++) {
                        var el = document.getElementById(required_contact_fields[i]);

                        // A field the surrounding form does not render, or keeps hidden, is not
                        // something the customer can fill in, so it must not block collection
                        if (!el || !isVisible(el)) {
                            continue;
                        }

                        if (el.value.trim() === '') {
                            return false;
                        }
                    }

                    return true;
                }

                function refreshCollectButton() {
                    var complete = contactFieldsComplete();

                    collect_button.disabled = !complete;

                    if (requirements_el) {
                        requirements_el.style.display = complete ? 'none' : '';
                    }
                }

                // Whether this form is the one being used to add a bank account right now. The pay
                // page renders the card form alongside this one, so the submit button must only be
                // held back while ACH is the payment method actually selected
                function isAddingBankAccount() {
                    var paymentType = form.querySelector('select[name="payment_type"]');

                    // Paying with an existing payment account
                    var payWithAccount = document.getElementById('pay_with_account');
                    var accountVisible = isVisible(document.getElementById('account'))
                        || (payWithAccount && payWithAccount.checked && document.querySelectorAll('select[name="payment_account"]').length);

                    // Paying with a new payment account
                    var payWithDetails = document.getElementById('pay_with_details');
                    var detailsEl = document.getElementById('details');
                    var detailsVisible = isVisible(detailsEl)
                        || (payWithDetails && payWithDetails.checked && document.querySelectorAll('select[name="payment_type"]').length);
                    var accountDetails = detailsVisible && ((detailsEl && detailsEl.value === 'ach') || (paymentType && paymentType.value === 'ach'));

                    // Add/update only the payment account (i.e. no payment)
                    var name = isVisible(document.getElementById('first_name'));

                    return !!(accountDetails || (name && !accountVisible && !detailsVisible));
                }

                function setSubmitVisible(visible) {
                    form.querySelectorAll('input[type="submit"], button[type="submit"]').forEach(function (btn) {
                        btn.style.display = visible ? '' : 'none';
                    });
                }

                // Whether a bank account still has to be collected before this form can be saved
                function needsCollection() {
                    return isAddingBankAccount() && !setup_complete && (!editing || replacing);
                }

                function refreshSubmitButton() {
                    // Accepting the mandate submits the form on its own, so the save button has
                    // nothing left to do while a bank account is being collected
                    if (needsCollection()) {
                        setSubmitVisible(false);
                        disableFormSubmission();
                    } else {
                        setSubmitVisible(true);
                        enableFormSubmission();
                    }
                }

                function showError(message) {
                    if (errors_el) {
                        errors_el.textContent = message || '';
                    }
                }

                function enableFormSubmission() {
                    submitting = false;
                    form.dataset.submitted = 'false';
                    form.dataset.submitting = 'false';
                    form.querySelectorAll('input[type="submit"], button[type="submit"]').forEach(function (btn) {
                        btn.disabled = false;
                        btn.classList.remove('disabled');
                    });

                    // The theme's double submit guard tracks state in jQuery's data store,
                    // which the dataset attributes above do not reach
                    if (window.jQuery) {
                        window.jQuery(form).data('submitted', false);
                    }
                }

                function disableFormSubmission() {
                    form.querySelectorAll('input[type="submit"], button[type="submit"]').forEach(function (btn) {
                        btn.disabled = true;
                        btn.classList.add('disabled');
                    });
                }

                // Always save the bank account, one-time payments are not supported
                var saveDetails = document.querySelector('#payment_details_ach input[name="save_details"]');
                if (saveDetails) {
                    saveDetails.checked = true;
                    if (saveDetails.parentNode) {
                        saveDetails.parentNode.style.display = 'none';
                    }
                }

                // Keep the collect button in step with the contact fields. Delegated listeners cover
                // everything the customer types or selects anywhere on the form
                form.addEventListener('input', deferredRefresh);
                form.addEventListener('change', deferredRefresh);

                function deferredRefresh() {
                    refresh();

                    // Choosing an existing contact populates the fields from another handler on this
                    // same event, so check again once that handler has run
                    setTimeout(refresh, 0);
                }

                function refresh() {
                    refreshCollectButton();
                    refreshSubmitButton();
                }

                // Changing the country reloads the state options over the network, which finishes
                // long after any event this form can listen for
                var state_el = document.getElementById('state');
                if (state_el && window.MutationObserver) {
                    new MutationObserver(refreshCollectButton).observe(state_el, {childList: true});
                }

                if (replace_button) {
                    replace_button.addEventListener('click', function () {
                        replacing = true;
                        current_step.style.display = 'none';
                        collect_step.style.display = '';
                        refresh();
                    });
                }

                refresh();

                // Step 1: open Stripe's hosted dialog, which handles instant verification and falls
                // back to manual account entry with microdeposits
                collect_button.addEventListener('click', function () {
                    showError('');
                    collect_button.disabled = true;

                    stripe_ach.collectBankAccountForSetup({
                        clientSecret: setup_secret,
                        params: {
                            payment_method_type: 'us_bank_account',
                            payment_method_data: {
                                billing_details: {
                                    name: fieldValue('first_name') + ' ' + fieldValue('last_name'),
                                    email: billing_email
                                }
                            }
                        },
                        expand: ['payment_method']
                    }).then(function (result) {
                        refreshCollectButton();

                        if (result.error) {
                            showError(result.error.message);
                        } else if (result.setupIntent.status === 'requires_payment_method') {
                            // The customer closed the dialog without picking an account
                            showError('<?php echo $this->Html->safe($this->_('StripePayments.ach_form.collect_cancelled', true));?>');
                        } else if (result.setupIntent.status === 'requires_confirmation') {
                            showMandate(result.setupIntent.payment_method);
                        }
                    });
                });

                // Step 2: the mandate must be displayed and accepted before the SetupIntent is
                // confirmed, per Stripe's ACH Direct Debit requirements
                function showMandate(payment_method) {
                    var summary = wrapper.querySelector('#ach-account-summary');
                    if (summary && payment_method && payment_method.us_bank_account) {
                        summary.textContent = (payment_method.us_bank_account.bank_name || '')
                            + ' •••• ' + (payment_method.us_bank_account.last4 || '');
                    }

                    collect_step.style.display = 'none';
                    mandate_step.style.display = '';
                }

                accept_button.addEventListener('click', function () {
                    showError('');
                    accept_button.disabled = true;
                    working_el.style.display = '';

                    // This call can take several seconds, so submission stays blocked until it
                    // settles. The submitting flag also cancels submits the disabled buttons cannot
                    // stop, such as pressing Enter in a text field or a jQuery-triggered submit
                    submitting = true;
                    disableFormSubmission();

                    stripe_ach.confirmUsBankAccountSetup(setup_secret).then(function (result) {
                        submitting = false;
                        accept_button.disabled = false;
                        working_el.style.display = 'none';

                        if (result.error) {
                            showError(result.error.message);
                            refreshSubmitButton();
                        } else if (result.setupIntent.status === 'requires_payment_method') {
                            showError('<?php echo $this->Html->safe($this->_('StripePayments.ach_form.confirm_failed', true));?>');
                            refreshSubmitButton();
                        } else {
                            completeSetup(result.setupIntent);
                        }
                    });
                });

                function completeSetup(setup_intent) {
                    // The PaymentMethod exists whether or not microdeposits are still pending
                    setWrapperField('reference_id', setup_intent.payment_method);
                    setWrapperField('type', 'checking');

                    var message = wrapper.querySelector('#ach-complete-message');
                    if (message) {
                        message.textContent = (setup_intent.next_action
                            && setup_intent.next_action.type === 'verify_with_microdeposits')
                            ? '<?php echo $this->Html->safe($this->_('StripePayments.ach_form.pending_microdeposits', true));?>'
                            : '<?php echo $this->Html->safe($this->_('StripePayments.ach_form.verified', true));?>';
                    }

                    mandate_step.style.display = 'none';
                    complete_step.style.display = '';

                    // The setup is done, so save the payment account without making the customer
                    // press a second button. This also covers the microdeposit case, where the
                    // account must be stored now so it can be verified later
                    setup_complete = true;
                    enableFormSubmission();
                    unbindSubmit();
                    resubmitForm();
                }

                // Bind natively for themes without jQuery, and through jQuery for callers that submit
                // with jQuery's trigger, which calls form.submit() and so dispatches no submit event
                function bindSubmit() {
                    form.addEventListener('submit', processBankAccount);
                    if (window.jQuery) {
                        window.jQuery(form).on('submit', processBankAccount);
                    }
                }

                function unbindSubmit() {
                    form.removeEventListener('submit', processBankAccount);
                    if (window.jQuery) {
                        window.jQuery(form).off('submit', processBankAccount);
                    }
                }

                // Resubmit with a real submit event, which reaches jQuery bound handlers and native
                // listeners alike, so the order plugin's payment authorization runs whether or not the
                // template ships jQuery. form.submit() would dispatch no event and reach neither.
                // A dispatched event carries no default action, so submit once nothing cancels it
                function resubmitForm() {
                    var submit_event = new Event('submit', {bubbles: true, cancelable: true});

                    if (form.dispatchEvent(submit_event)) {
                        form.submit();
                    }
                }

                // Only intercept the submit when this form is the one adding a bank account
                bindSubmit();

                function processBankAccount(event) {
                    // A real submit reaches both the native and the jQuery handler, and no submit may
                    // post the form while the mandate confirmation is still in flight
                    if (submitting) {
                        event.preventDefault();
                        return;
                    }

                    var paymentType = form.querySelector('select[name="payment_type"]');

                    // Disable the CC form so its fields are not submitted
                    if (paymentType && paymentType.value === 'ach') {
                        var ccDetails = document.getElementById('payment_details_cc');
                        if (ccDetails) {
                            ccDetails.querySelectorAll('input').forEach(function (el) {
                                el.disabled = true;
                            });
                        }
                    }

                    if (needsCollection()) {
                        // The bank account must be collected and the mandate accepted before the
                        // form can be submitted, since the reference_id comes from the SetupIntent
                        if (!wrapperField('reference_id')) {
                            event.preventDefault();
                            showError('<?php echo $this->Html->safe($this->_('StripePayments.ach_form.not_collected', true));?>');
                            refreshSubmitButton();
                        }
                    }
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>
</div>
